{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=moderate",
    "predeploy:auth": "npm run audit:ci && npx prisma validate && npm run tenant:preflight && npm run email:outbox:encrypt-legacy",
    "test": "tsx --test src/app.test.ts src/config/env.test.ts src/jobs/branchProtection.test.ts src/jobs/tenantMigration.test.ts src/lib/email.test.ts src/lib/metrics.test.ts src/middlewares/role.middleware.test.ts src/modules/auth/auth.schema.test.ts src/utils/hash.test.ts src/utils/token.test.ts",
    "test:integration": "tsx src/jobs/requireDbIntegrationTests.ts && tsx --test src/modules/auth/auth.integration.test.ts",
    "test:integration:optional": "tsx --test src/modules/auth/auth.integration.test.ts",
    "test:integration:db": "npm run test:integration",
    "tokens:cleanup": "tsx src/jobs/cleanupTokens.ts",
    "email:outbox": "tsx src/jobs/processEmailOutbox.ts",
    "email:outbox:sent-unknown": "tsx src/jobs/listSentUnknownEmailOutbox.ts",
    "email:outbox:encrypt-legacy": "tsx src/jobs/encryptEmailOutboxLegacy.ts",
    "email:outbox:rotate-key": "tsx src/jobs/rotateEmailOutboxKey.ts",
    "tenant:preflight": "tsx src/jobs/preflightTenantMigration.ts",
    "tenant:backfill-stores": "tsx src/jobs/backfillStoreOrganizations.ts",
    "github:branch-protection:check": "tsx src/jobs/checkBranchProtection.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.11.1",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "nodemailer": "^8.0.10",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "hono": "^4.12.25"
  }
}
