generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AuditAction {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REFRESH_TOKEN
  TOKEN_REUSE_DETECTED
  ACCESS_DENIED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  SENT_UNKNOWN
  FAILED
}

enum LoginLockIdentityType {
  EMAIL
  IP
}

model User {
  id           String       @id @default(cuid())
  firstName    String
  lastName     String
  email        String       @unique
  password     String
  role         Role         @default(EMPLOYEE)
  platformRole PlatformRole @default(USER)
  isActive     Boolean      @default(true)

  sessions      Session[]
  storeAccesses UserStoreAccess[]
  memberships   Membership[]
  auditLogs     AuditLog[]
  authTokens    AuthToken[]
  loginAttempts LoginAttempt[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  emailVerifiedAt DateTime?

  @@index([email])
  @@index([role])
  @@index([platformRole])
}

model Organization {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true)

  memberships Membership[]
  stores      Store[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model Store {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  address  String?
  isActive Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  warehouses   Warehouse[]
  userAccesses UserStoreAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([organizationId])
}

model Membership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role Role @default(EMPLOYEE)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
}

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  location String?
  isActive Boolean @default(true)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([code])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model RolePermission {
  id String @id @default(cuid())

  role Role

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model UserStoreAccess {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  role Role @default(EMPLOYEE)

  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([role])
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status SessionStatus @default(ACTIVE)

  userAgent String?
  ipAddress String?

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([userId])
  @@index([status])
}

model RefreshToken {
  id String @id @default(cuid())

  tokenHash String @unique
  familyId  String

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  revokedAt         DateTime?
  rotatedAt         DateTime?
  graceConsumedAt   DateTime?
  replacedByTokenId String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([sessionId])
  @@index([familyId])
  @@index([replacedByTokenId])
  @@index([graceConsumedAt])
  @@index([revokedAt, expiresAt])
}

model RefreshRotation {
  id String @id @default(cuid())

  previousRefreshTokenId String @unique
  rotatedRefreshTokenId  String
  sessionId              String
  familyId               String
  contextHash            String

  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([sessionId])
  @@index([contextHash, createdAt])
}

model AuthToken {
  id String @id @default(cuid())

  tokenHash String           @unique
  purpose   AuthTokenPurpose

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action        AuditAction
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([correlationId])
  @@index([createdAt])
}

model LoginAttempt {
  id String @id @default(cuid())

  email String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?
  success   Boolean @default(false)
  reason    String?

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@index([success, createdAt])
}

model LoginLock {
  id String @id @default(cuid())

  identityType LoginLockIdentityType
  identityKey  String

  failedCount   Int       @default(0)
  lockedUntil   DateTime?
  lastFailureAt DateTime?
  lastSuccessAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identityType, identityKey])
  @@index([lockedUntil])
  @@index([identityType, lockedUntil])
}

model EmailOutbox {
  id String @id @default(cuid())

  messageId String @unique
  to        String
  subject   String
  text      String
  html      String

  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  lastError         String?
  lastErrorSource   String?
  providerMessageId String?
  encryptionKeyId   String?
  nextAttemptAt     DateTime    @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  sentAt            DateTime?
  sentUnknownAt     DateTime?
  encryptedAt       DateTime?
  scrubbedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@index([encryptionKeyId])
  @@index([createdAt])
}
