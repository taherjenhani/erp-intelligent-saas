generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SessionTerminationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_RESET
  PASSWORD_CHANGED
  REFRESH_TOKEN_REUSE
  SESSION_EXPIRED
  ADMIN_REVOKED
}

enum AuditAction {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REFRESH_TOKEN
  TOKEN_REUSE_DETECTED
  ACCESS_DENIED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  SENT_UNKNOWN
  FAILED
}

enum LoginLockIdentityType {
  EMAIL
  IP
}

enum AuthActionRateLimitAction {
  FORGOT_PASSWORD
  RESEND_VERIFICATION
  REGISTER_IP
}

enum SecurityEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REFRESH_TOKEN
  TOKEN_REUSE_DETECTED
  ACCESS_DENIED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ACCOUNT_LOCKOUT
  API_KEY_AUTHENTICATED
  MFA_CHALLENGE_CREATED
  MFA_CHALLENGE_VERIFIED
}

enum SecurityEventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MfaFactorType {
  TOTP
  WEBAUTHN
  RECOVERY_CODE
}

enum MfaFactorStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum MfaChallengeStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

model User {
  id                  String       @id @default(cuid())
  firstName           String
  lastName            String
  email               String       @unique
  password            String
  passwordPepperKeyId String?
  role                Role         @default(EMPLOYEE)
  platformRole        PlatformRole @default(USER)
  isActive            Boolean      @default(true)

  sessions        Session[]
  storeAccesses   UserStoreAccess[]
  memberships     Membership[]
  auditLogs       AuditLog[]
  authTokens      AuthToken[]
  loginAttempts   LoginAttempt[]
  securityEvents  SecurityEvent[]
  apiKeys         ApiKey[]
  mfaFactors      MfaFactor[]
  mfaChallenges   MfaChallenge[]
  passwordHistory PasswordHistory[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  emailVerifiedAt DateTime?

  @@index([email])
  @@index([role])
  @@index([platformRole])
}

model Organization {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true)

  memberships Membership[]
  stores      Store[]
  apiKeys     ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model Store {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  address  String?
  isActive Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  warehouses   Warehouse[]
  userAccesses UserStoreAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([organizationId])
}

model Membership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role Role @default(EMPLOYEE)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([role])
}

model Warehouse {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  location String?
  isActive Boolean @default(true)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([code])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model RolePermission {
  id String @id @default(cuid())

  role Role

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model UserStoreAccess {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  role Role @default(EMPLOYEE)

  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([role])
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            SessionStatus             @default(ACTIVE)
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  terminatedAt      DateTime?
  terminatedBy      String?
  terminatedReason  SessionTerminationReason?

  userAgent             String?
  ipAddress             String?
  deviceName            String?
  deviceFingerprintHash String?

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([userId])
  @@index([status])
  @@index([revokedAt])
  @@index([lastUsedAt])
  @@index([terminatedAt])
  @@index([deviceFingerprintHash])
}

model RefreshToken {
  id String @id @default(cuid())

  tokenHash String @unique
  familyId  String

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  revokedAt         DateTime?
  rotatedAt         DateTime?
  graceConsumedAt   DateTime?
  replacedByTokenId String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([sessionId])
  @@index([familyId])
  @@index([replacedByTokenId])
  @@index([graceConsumedAt])
  @@index([revokedAt, expiresAt])
}

model RefreshRotation {
  id String @id @default(cuid())

  previousRefreshTokenId String    @unique
  rotatedRefreshTokenId  String
  sessionId              String
  familyId               String
  contextHash            String
  idempotencyKeyHash     String?
  responseRefreshToken   String?
  idempotencyExpiresAt   DateTime?

  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([sessionId])
  @@index([previousRefreshTokenId, idempotencyKeyHash])
  @@index([contextHash, createdAt])
  @@index([idempotencyExpiresAt])
}

model AuthToken {
  id String @id @default(cuid())

  tokenHash String           @unique
  purpose   AuthTokenPurpose

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
}

model PasswordHistory {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  passwordHash        String
  passwordPepperKeyId String?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action        AuditAction
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([correlationId])
  @@index([createdAt])
}

model SecurityEvent {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type          SecurityEventType
  severity      SecurityEventSeverity @default(INFO)
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadata      Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([correlationId])
  @@index([createdAt])
}

model LoginAttempt {
  id String @id @default(cuid())

  email String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?
  success   Boolean @default(false)
  reason    String?

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@index([success, createdAt])
}

model ApiKey {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  keyHash   String       @unique
  keyPrefix String
  scopes    Json?
  status    ApiKeyStatus @default(ACTIVE)

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Database migration enforces exactly one owner: userId XOR organizationId.

  @@index([userId])
  @@index([organizationId])
  @@index([keyPrefix])
  @@index([status, expiresAt])
}

model MfaFactor {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   MfaFactorType
  status MfaFactorStatus @default(PENDING)
  label  String?

  encryptedSecret String?
  encryptionKeyId String?
  publicKey       String?

  lastUsedAt DateTime?
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  challenges MfaChallenge[]

  @@index([userId])
  @@index([type])
  @@index([status])
}

model MfaChallenge {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  factorId String?
  factor   MfaFactor? @relation(fields: [factorId], references: [id], onDelete: SetNull)

  type   MfaFactorType
  status MfaChallengeStatus @default(PENDING)

  challengeHash String?
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([factorId])
  @@index([status, expiresAt])
}

model LoginLock {
  id String @id @default(cuid())

  identityType LoginLockIdentityType
  identityKey  String

  failedCount   Int       @default(0)
  lockedUntil   DateTime?
  lastFailureAt DateTime?
  lastSuccessAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identityType, identityKey])
  @@index([lockedUntil])
  @@index([identityType, lockedUntil])
}

model AuthActionRateLimit {
  id String @id @default(cuid())

  action      AuthActionRateLimitAction
  identityKey String

  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  lockedUntil     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([action, identityKey])
  @@index([action, windowStartedAt])
  @@index([lockedUntil])
}

model EmailOutbox {
  id String @id @default(cuid())

  messageId      String @unique
  idempotencyKey String @unique
  to             String
  subject        String
  text           String
  html           String

  status            EmailStatus @default(PENDING)
  attempts          Int         @default(0)
  lastError         String?
  lastErrorSource   String?
  providerMessageId String?
  encryptionKeyId   String?
  nextAttemptAt     DateTime    @default(now())
  lockedAt          DateTime?
  lockedBy          String?
  sentAt            DateTime?
  sentUnknownAt     DateTime?
  encryptedAt       DateTime?
  scrubbedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([lockedAt])
  @@index([encryptionKeyId])
  @@index([createdAt])
}
